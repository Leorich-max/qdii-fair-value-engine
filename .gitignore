# ---- data: keep the synthetic sample and the daily pipeline's NAV/parity histories only ----
# data/live/ holds published fund NAVs and the official CFETS parity (no market prices); it is the
# pipeline's memory (first-seen times) and is committed by the daily workflow. Anything else stays out.
data/*
!data/sample/
!data/live/

# ---- secrets & real, calibrated parameters (deliberately withheld) ----
config.yaml
.env
*.key
sckey.txt

# ---- local-only, never publish ----
interview_prep.md

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- notebooks: never commit executed outputs ----
.ipynb_checkpoints/

# ---- local previews (synthetic dashboard build) ----
outputs/
